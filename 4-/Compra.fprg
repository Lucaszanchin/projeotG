<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="compra"/>
        <attribute name="authors" value="DES-I1HS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-14 08:21:00 "/>
        <attribute name="created" value="REVTLUkxSFM7RVNONTEyTjlNVEI3NzQ7MjAyNS0wNC0xNDsiMDg6MDQ6NDkgIjsyNjQ2"/>
        <attribute name="edited" value="REVTLUkxSFM7RVNONTEyTjlNVEI3NzQ7MjAyNS0wNC0xNDsiMDg6MjE6MDAgIjsxOzI3NDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="compraValor, valorDesconto, valorTotal" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor da compra?&quot;" newline="True"/>
            <input variable="compraValor"/>
            <if expression="compraValor &gt;=100">
                <then>
                    <assign variable="valorDesconto" expression="compraValor *0.1"/>
                    <assign variable="valorTotal" expression="compraValor - valorDesconto"/>
                    <output expression="&quot;Voc&#234; ganhou 10% de desconto na sua compra :)&quot;" newline="True"/>
                    <output expression="&quot;O valor do desconto &#233;:&quot; &amp;valorDesconto" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Voc&#234; n&#227;o ganhou nenhum desconto :(&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;O valor da compra &#233;:&quot; &amp;valorTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
