    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numMulti" type="Real" array="False" size=""/>
            <output expression="&quot;Escreva o n&#250;mero que voc&#234; deseja&quot;" newline="True"/>
            <input variable="numMulti"/>
            <if expression="numMulti %5=0">
                <then>
                    <output expression="&quot;O n&#250;mero &#233; multiplo de 5.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero n&#227;o &#233; multiplo de 5.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
